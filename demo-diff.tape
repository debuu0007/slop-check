Output assets/demo-diff.gif

Set Shell "bash"
Set Theme "Catppuccin Mocha"
Set FontSize 17
Set Width 1100
Set Height 650
Set TypingSpeed 18ms

Type "printf '%s\\n' 'diff --git a/api.ts b/api.ts' '--- a/api.ts' '+++ b/api.ts' '@@ -0,0 +1 @@' '+// TODO: proper validation' | node dist/cli.js --diff --explain"
